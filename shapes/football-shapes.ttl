@prefix fb:   <https://vdhugn.github.io/Football-LOD/ontology#> .
@prefix fbs:  <https://vdhugn.github.io/Football-LOD/shapes#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

fbs:PlayerShape a sh:NodeShape ;
    sh:targetClass fb:Player ;
    sh:property [ sh:path fb:playsFor ; sh:maxCount 1 ; sh:class fb:Club ] ;
    sh:property [ sh:path fb:representsNationalTeam ; sh:maxCount 1 ; sh:class fb:NationalTeam ] ;
    sh:property [ sh:path fb:dateOfBirth ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path fb:heightCm ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

fbs:ClubShape a sh:NodeShape ;
    sh:targetClass fb:Club ;
    sh:property [ sh:path fb:homeStadium ; sh:maxCount 1 ; sh:class fb:Stadium ] ;
    sh:property [ sh:path fb:domesticCompetition ; sh:maxCount 1 ; sh:class fb:Competition ] .

fbs:TransferShape a sh:NodeShape ;
    sh:targetClass fb:Transfer ;
    sh:property [ sh:path fb:transferOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Player ] ;
    sh:property [ sh:path fb:fromClub ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Club ] ;
    sh:property [ sh:path fb:toClub ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Club ] ;
    sh:property [ sh:path fb:transferDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path fb:transferFee ; sh:maxCount 1 ; sh:minExclusive 0 ] .

fbs:MarketValuationShape a sh:NodeShape ;
    sh:targetClass fb:MarketValuation ;
    sh:property [ sh:path fb:valuationOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Player ] ;
    sh:property [ sh:path fb:valuationDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path fb:atClub ; sh:maxCount 1 ; sh:class fb:Club ] .
